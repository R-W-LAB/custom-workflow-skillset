{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/.tmp/marketplaces/custom-workflow-skillset/plugins/custom-workflow-skillset/scripts/session_start_long_goal_context.py\"",
            "timeout": 10,
            "statusMessage": "Checking long-goal context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/.tmp/marketplaces/custom-workflow-skillset/plugins/custom-workflow-skillset/scripts/user_prompt_submit_goal_classifier.py\"",
            "timeout": 10,
            "statusMessage": "Checking serious-plan fit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/.tmp/marketplaces/custom-workflow-skillset/plugins/custom-workflow-skillset/scripts/pre_tool_use_safety_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking command safety"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/.tmp/marketplaces/custom-workflow-skillset/plugins/custom-workflow-skillset/scripts/permission_request_policy.py\"",
            "timeout": 10,
            "statusMessage": "Checking YOLO policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/.tmp/marketplaces/custom-workflow-skillset/plugins/custom-workflow-skillset/scripts/post_tool_use_verification_capture.py\"",
            "timeout": 10,
            "statusMessage": "Capturing verification evidence"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/.tmp/marketplaces/custom-workflow-skillset/plugins/custom-workflow-skillset/scripts/stop_goal_incomplete_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking long-goal continuation"
          }
        ]
      }
    ]
  }
}
